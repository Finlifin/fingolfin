use tt_emule.types.{Observation, Core};
fn observe on tt_emule.device.core.compute.pack_tile_block(call: Observation, core: Core, ifrom_dst: u32, ocb: u32, ntiles: u32) {
 if call.phase == 0 { builtin.counter_add(0, 1); } else { builtin.counter_add(1, 1); }
 if core.x == 0 && core.y == 0 && call.thread > 0 { builtin.counter_add(2, 1); }
 builtin.emit(call.phase, call.sequence);
 builtin.emit(ifrom_dst, call.sequence);
 builtin.emit(ocb, call.sequence);
 builtin.emit(ntiles, call.sequence);
}
