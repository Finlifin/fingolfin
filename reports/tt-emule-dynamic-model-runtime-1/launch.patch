+
+extern "C" uint64_t fg_tt_launch_begin(uint64_t device) __attribute__((weak));
+extern "C" void fg_tt_launch_end(uint64_t token) __attribute__((weak));
+struct FgLaunchScope {
+    uint64_t token = 0;
+    explicit FgLaunchScope(uint64_t device, bool enabled = true) {
+        if (enabled && fg_tt_launch_begin && fg_tt_launch_end) token = fg_tt_launch_begin(device);
+    }
+    ~FgLaunchScope() { if (token) fg_tt_launch_end(token); }
+    FgLaunchScope(const FgLaunchScope&) = delete;
+};
 
