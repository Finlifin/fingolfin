use tt_emule.types.{Observation, Core};
fn observe on tt_emule.device.core.noc.noc_semaphore_inc(call: Observation, core: Core, noc_addr: u64, incr: u32, noc: u8) {
 if call.phase == 0 { builtin.counter_add(0, 1); } else { builtin.counter_add(1, 1); }
 if core.x == 0 && core.y == 0 && call.thread > 0 { builtin.counter_add(2, 1); }
 builtin.emit(call.phase, call.sequence);
 builtin.emit(16, noc_addr);
 builtin.emit(incr, call.sequence);
 if noc / 1 % 2 == 1 { builtin.emit(48, 1); } else { builtin.emit(48, 0); }
 if noc / 2 % 2 == 1 { builtin.emit(49, 1); } else { builtin.emit(49, 0); }
 if noc / 4 % 2 == 1 { builtin.emit(50, 1); } else { builtin.emit(50, 0); }
 if noc / 8 % 2 == 1 { builtin.emit(51, 1); } else { builtin.emit(51, 0); }
 if noc / 16 % 2 == 1 { builtin.emit(52, 1); } else { builtin.emit(52, 0); }
 if noc / 32 % 2 == 1 { builtin.emit(53, 1); } else { builtin.emit(53, 0); }
 if noc / 64 % 2 == 1 { builtin.emit(54, 1); } else { builtin.emit(54, 0); }
 if noc / 128 % 2 == 1 { builtin.emit(55, 1); } else { builtin.emit(55, 0); }
}
