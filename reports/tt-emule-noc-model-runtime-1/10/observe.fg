use tt_emule.types.{Observation, Core};
fn observe on tt_emule.device.core.noc.noc_async_write_barrier(call: Observation, core: Core, noc: u8) {
 if call.phase == 0 { builtin.counter_add(0, 1); } else { builtin.counter_add(1, 1); }
 if core.x == 0 && core.y == 0 && call.thread > 0 { builtin.counter_add(2, 1); }
 builtin.emit(call.phase, call.sequence);
 if noc / 1 % 2 == 1 { builtin.emit(32, 1); } else { builtin.emit(32, 0); }
 if noc / 2 % 2 == 1 { builtin.emit(33, 1); } else { builtin.emit(33, 0); }
 if noc / 4 % 2 == 1 { builtin.emit(34, 1); } else { builtin.emit(34, 0); }
 if noc / 8 % 2 == 1 { builtin.emit(35, 1); } else { builtin.emit(35, 0); }
 if noc / 16 % 2 == 1 { builtin.emit(36, 1); } else { builtin.emit(36, 0); }
 if noc / 32 % 2 == 1 { builtin.emit(37, 1); } else { builtin.emit(37, 0); }
 if noc / 64 % 2 == 1 { builtin.emit(38, 1); } else { builtin.emit(38, 0); }
 if noc / 128 % 2 == 1 { builtin.emit(39, 1); } else { builtin.emit(39, 0); }
}
