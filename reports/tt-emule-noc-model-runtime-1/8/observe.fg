use tt_emule.types.{Observation, Core};
fn observe on tt_emule.device.core.noc.noc_async_write(call: Observation, core: Core, src_local_l1_addr: u32, dst_noc_addr: u64, size: u32) {
 if call.phase == 0 { builtin.counter_add(0, 1); } else { builtin.counter_add(1, 1); }
 if core.x == 0 && core.y == 0 && call.thread > 0 { builtin.counter_add(2, 1); }
 builtin.emit(call.phase, call.sequence);
 builtin.emit(src_local_l1_addr, call.sequence);
 builtin.emit(17, dst_noc_addr);
 builtin.emit(size, call.sequence);
}
